# Postgres local:
#   PGHOST=localhost / PGPORT=5432 / PGDATABASE=fca_gap / PGUSER=postgres / PGSSL=false
#
# Supabase: botão Connect no topo do projeto.
#   - "Direct connection" só resolve em IPv6 hoje — se sua rede não tiver
#     IPv6 (comum em rede doméstica/corporativa), a conexão falha com
#     ENOTFOUND. Nesse caso use a aba "Session pooler" (IPv4):
#     PGHOST=aws-0-<regiao>.pooler.supabase.com
#     PGUSER=postgres.<project-ref>  (não é só "postgres")
#   - Senha: Project Settings > Database > "Reset database password".
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSL=true

PORT=3000
NODE_ENV=development

# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# E-mail (convite e aviso de atribuição). Gmail: myaccount.google.com
# > Segurança > ative a verificação em duas etapas > depois gere a senha
# em myaccount.google.com/apppasswords (16 letras — NÃO é a senha normal
# da conta). Sem essas duas variáveis, o app só loga no console em vez
# de mandar e-mail de verdade.
EMAIL_USER=
EMAIL_PASS=

# Base usada nos links dos e-mails (ex: /definir-senha.html?token=...).
APP_BASE_URL=http://localhost:3000
